{
  "name": "pi-double-escape-clear",
  "version": "1.1.3",
  "description": "Pi coding agent extension — double-press Escape to clear the editor without aborting a running task, plus /restore to bring back past prompts",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "extension",
    "escape",
    "double-escape",
    "editor",
    "clear",
    "interrupt"
  ],
  "main": "extensions/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "publish:beta": "npm publish --tag beta"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
